# Club is intentionally pre-launch and not accepting real payments yet, so
# this is Stripe's TEST-mode publishable key on purpose (2026-07-18). Real
# cards will be declined — only Stripe's test card numbers work. Swap for a
# pk_live_... key (and confirm the Extend service's STRIPE_SECRET_KEY is the
# matching sk_live_... one) when Club is ready to take real payments.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51HRtGXJOO62KcifmrcMclTUuB5K9y0Qsl9qBN7koneayHyXsv8Qfp4TzaWi7gHphvnPykooPymksT62y1fJtTFcp00BhObsrMS

# Relay (TURN) comes from AGS TURN Manager, which the browser calls directly
# with the signed-in player's AGS token. Derived from VITE_ACCELBYTE_BASE_URL
# when unset, so it only needs naming here to point somewhere else.
#
# This is a service *base*, not the list endpoint: AGS needs two calls, /turn
# for the server list and /turn/secret/... for a short-lived credential.
# Pointing VITE_RTC_ICE_CONFIG_URL at .../turnmanager/turn instead is what
# produced "managed TURN unavailable" — that list carries no credentials.
# VITE_AGS_TURN_MANAGER_URL=https://seal-chessags.prod.gamingservices.accelbyte.io/turnmanager
#
# Set VITE_RTC_ICE_CONFIG_URL only to override AGS with your own single-shot
# endpoint returning {"iceServers":[...],"ttl":...}. It wins when both are set.
VITE_RTC_ICE_CONFIG_URL=

# History + Journal learning loop rollout (dev-plan/history-journal-learning-loop-development-plan.md §17.1).
# Sequenced one milestone at a time, each observed ~7 days before the next.
# Stage 1 (2026-07-18): M0-M3 — History enrichment/paging + Quick Review. No new persisted data.
VITE_LEARNING_HISTORY_V2=1
VITE_LEARNING_REVIEW_V2=1
# Stage 2 (not yet enabled): M4-M7 — private learning index, practice queue, goals v2, journal layout v2.
VITE_LEARNING_INDEX_V1=0
VITE_LEARNING_PRACTICE_V2=0
VITE_LEARNING_GOALS_V2=0
VITE_LEARNING_JOURNAL_LAYOUT_V2=0
# Stage 3 (not yet enabled): N0-N4 practice/review notifications, staged by rollout percentage.
VITE_LEARNING_NOTIFICATIONS_V1=0
VITE_LEARNING_NATIVE_REMINDERS_V1=0
