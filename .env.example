ACCELBYTE_BASE_URL=https://seal-chessags.prod.gamingservices.accelbyte.io
ACCELBYTE_NAMESPACE=seal-chessags
ACCELBYTE_CLIENT_ID=4d98466a671d4172aa98f9a3f1fa29d1

VITE_ACCELBYTE_BASE_URL=https://seal-chessags.prod.gamingservices.accelbyte.io
VITE_ACCELBYTE_NAMESPACE=seal-chessags
VITE_ACCELBYTE_CLIENT_ID=4d98466a671d4172aa98f9a3f1fa29d1

# Stripe's publishable key (pk_...) is not secret — it's meant to ship in
# frontend JS — but it must match whichever STRIPE_SECRET_KEY the Extend
# service is running with (both test-mode or both live-mode). Powers the
# embedded Checkout mounted in the Club screen (src/club.js).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Change this to your machine's local IP address (or https://localhost:8808/ if testing locally only)
# Mac: run `ipconfig getifaddr en0` to find your IP
# Windows: run `ipconfig` and look for IPv4 Address
VITE_ACCELBYTE_REDIRECT_URI=https://localhost:8808/

# Relayed video calls use AGS TURN Manager by default, derived from
# VITE_ACCELBYTE_BASE_URL. Set this only to point at a different AGS host.
# It is the service base — the client calls /turn for the server list and
# /turn/secret/{region}/{ip}/{port} for a short-lived credential, and no TURN
# secret ever reaches the bundle because AGS mints one per player per call.
# VITE_AGS_TURN_MANAGER_URL=https://YOUR_SUBDOMAIN.prod.gamingservices.accelbyte.io/turnmanager

# Optional override, and only for a *non-AGS* relay. A same-origin or
# CORS-enabled HTTPS endpoint returning short-lived credentials in one shot;
# never place a long-lived TURN secret in a VITE_ variable. Takes precedence
# over VITE_AGS_TURN_MANAGER_URL when both are set.
# Response: {"iceServers":[{"urls":["turn:turn.example.com:3478?transport=udp","turns:turn.example.com:5349"],"username":"...","credential":"..."}],"ttl":600}
VITE_RTC_ICE_CONFIG_URL=

# History + Journal learning loop rollout flags
# (dev-plan/history-journal-learning-loop-development-plan.md §5.5).
# Set to 1 to enable a milestone; leave unset/0 in production until that
# milestone's acceptance criteria pass. Web enables before iPad.
VITE_LEARNING_HISTORY_V2=0
VITE_LEARNING_REVIEW_V2=0
VITE_LEARNING_INDEX_V1=0
VITE_LEARNING_PRACTICE_V2=0
VITE_LEARNING_GOALS_V2=0
VITE_LEARNING_JOURNAL_LAYOUT_V2=0
